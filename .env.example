# ---------------------------------------------------------------------------
# Noe — variables d'environnement.
#
# Ce fichier est SUIVI par git et ne contient QUE des noms de cles et des
# valeurs factices. Copiez-le en `.env` (ignore par git) et remplissez-le.
#
#   cp .env.example .env
#
# Aucune valeur reelle ne doit jamais apparaitre ici. La CI le verifie.
# ---------------------------------------------------------------------------

# --- Azure OpenAI (souscription sponsorisee Microsoft for Startups) ---------
# Ressource first-party, couverte par les credits. Voir docs/setup-checklist.md.
AZURE_OPENAI_ENDPOINT=https://REMPLACER_RESSOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=REMPLACER_CLE_AZURE_OPENAI
AZURE_OPENAI_API_VERSION=2024-10-21
# Deploiement « mini » : tri, classification, extraction bon marche.
AZURE_OPENAI_DEPLOIEMENT_TRI=REMPLACER_NOM_DEPLOIEMENT_MINI
# Deploiement « frontier » : execution, raisonnement sur episode.
AZURE_OPENAI_DEPLOIEMENT_EXECUTION=REMPLACER_NOM_DEPLOIEMENT_FRONTIER

# --- Anthropic (optionnel, budget cash separe, JAMAIS via Azure Marketplace) -
# Ne remplir que si le rejeu a tranche en faveur de Claude sur l'etage execution.
ANTHROPIC_API_KEY=REMPLACER_CLE_ANTHROPIC

# --- Systeme de verite n°1 : variante Salesforce ----------------------------
SALESFORCE_CLIENT_ID=REMPLACER_CONSUMER_KEY
SALESFORCE_CLIENT_SECRET=REMPLACER_CONSUMER_SECRET
SALESFORCE_REDIRECT_URI=http://localhost:53682/callback
SALESFORCE_LOGIN_URL=https://login.salesforce.com

# --- Systeme de verite n°1 : variante Google Workspace ----------------------
GOOGLE_CLIENT_ID=REMPLACER_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REMPLACER_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:53683/callback

# --- Socle commercial -------------------------------------------------------
# Stripe : mode TEST uniquement tant que le gate humain live n'est pas franchi.
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXX
STRIPE_WEBHOOK_SECRET=REMPLACER_WHSEC

# Supabase : projet noe-prod, JAMAIS le projet Elevay.
SUPABASE_URL=https://REMPLACER_REF.supabase.co
SUPABASE_ANON_KEY=REMPLACER_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REMPLACER_SERVICE_ROLE_KEY

# Licences : paire ed25519. La privee signe cote serveur, la publique est
# compilee dans l'app et verifie hors ligne.
LICENCE_SIGNING_PRIVATE_KEY=REMPLACER_ED25519_PRIVEE_BASE64
LICENCE_SIGNING_PUBLIC_KEY=REMPLACER_ED25519_PUBLIQUE_BASE64

# --- Observabilite (projets dedies Noe, pas ceux d'Elevay) ------------------
SENTRY_DSN=REMPLACER_DSN_SENTRY
POSTHOG_API_KEY=REMPLACER_CLE_POSTHOG
POSTHOG_HOST=https://eu.i.posthog.com
RESEND_API_KEY=REMPLACER_CLE_RESEND

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noe",
  "version": "0.0.0",
  "identifier": "app.noe.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Noe",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "copyright": "Copyright (c) 2026 Martin Paviot",
    "shortDescription": "L'esprit qui comprend le travail avant de le faire."
  }
}

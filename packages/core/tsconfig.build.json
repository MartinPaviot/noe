{
  // Le build EXCLUT les tests, et c'est ce qui a revele le vrai probleme.
  //
  // Le compilateur a d'abord refuse `setTimeout` : son type n'arrivait dans la
  // compilation que par les fichiers de test, qui importent vitest. J'ai fait
  // taire le message en ajoutant `@types/node`, c'est-a-dire en declarant que ce
  // paquet a le droit d'avoir une horloge.
  //
  // Il ne l'a pas. L'INVARIANT VI dit que `@noe/core` est pur — aucune horloge,
  // aucun hasard non injecte — et le compilateur disait donc la verite. Le
  // minuteur est parti chez l'appelant, la dependance avec lui, et il ne reste
  // ici aucun type d'environnement a declarer.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "exclude": ["src/**/*.test.ts"]
}
